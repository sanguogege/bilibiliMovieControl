{
    "name": "B站连播助手",
    "description": "基于 SolidJS 开发的 Bilibili 视频跳转工具",
    "private": true,
    "version": "1.3.6",
    "type": "module",
    "scripts": {
        "dev:edge": "wxt -b edge",
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "tsc --noEmit",
        "postinstall": "wxt prepare",
        "change": "bun changeset",
        "version": "bun changeset version",
        "status": "bun changeset status",
        "release": "bun run build:all && bun run zip:all && (bun run submit:edge || true) && (bun run submit:firefox || true)",
        "build:all": "wxt build -b firefox && wxt build -b edge",
        "zip:all": "wxt zip -b firefox && wxt zip -b edge",
        "submit:firefox": "wxt submit --firefox-zip .output/*firefox*.zip --firefox-sources-zip .output/*sources.zip",
        "submit:edge": "wxt submit --edge-zip .output/*edge*.zip"
    },
    "dependencies": {
        "@lucide/solid": "^1.61.0",
        "@solidjs/router": "^2.0.0-next.42",
        "@solidjs/web": "^2.0.0-rc.18",
        "@tailwindcss/vite": "^4.3.3",
        "daisyui": "^5.7.50",
        "solid-js": "^2.0.0-rc.18",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@solidjs/vite-plugin": "^3.0.0-next.51",
        "typescript": "^5.9.3",
        "web-ext": "10.6.0",
        "wxt": "^0.21.4"
    }
}